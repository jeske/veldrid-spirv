<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="Nuget">
        <PackageId>ArtificialNecessity.Veldrid.SPIRV</PackageId>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyName>ArtificialNecessity.Veldrid.SPIRV</AssemblyName>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DocumentationFile>$(BinDir)\$(AssemblyName).xml</DocumentationFile>
        <NativeAssetsPath>$(RepositoryRootDirectory)\build\$(Configuration)\</NativeAssetsPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ArtificialNecessity.Veldrid" Version="$(ANVeldridVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(NativeAssetsPath)win-x64\libveldrid-spirv.dll" Condition="Exists('$(NativeAssetsPath)win-x64\libveldrid-spirv.dll')">
            <PackagePath>runtimes/win-x64/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)win-x86\libveldrid-spirv.dll" Condition="Exists('$(NativeAssetsPath)win-x86\libveldrid-spirv.dll')">
            <PackagePath>runtimes/win-x86/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)win-arm64\libveldrid-spirv.dll" Condition="Exists('$(NativeAssetsPath)win-arm64\libveldrid-spirv.dll')">
            <PackagePath>runtimes/win-arm64/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)osx\libveldrid-spirv.dylib" Condition="Exists('$(NativeAssetsPath)osx\libveldrid-spirv.dylib')">
            <PackagePath>runtimes/osx/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)linux-x64\libveldrid-spirv.so" Condition="Exists('$(NativeAssetsPath)linux-x64\libveldrid-spirv.so')">
            <PackagePath>runtimes/linux-x64/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)linux-arm64\libveldrid-spirv.so" Condition="Exists('$(NativeAssetsPath)linux-arm64\libveldrid-spirv.so')">
            <PackagePath>runtimes/linux-arm64/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)ios\**\veldrid-spirv.xcframework\**\*" Condition="Exists('$(NativeAssetsPath)ios')">
            <PackagePath>runtimes/ios/native/veldrid-spirv.xcframework</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)android-armeabi-v7a\libveldrid-spirv.so" Condition="Exists('$(NativeAssetsPath)android-armeabi-v7a\libveldrid-spirv.so')">
            <PackagePath>runtimes/android-arm/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)android-arm64-v8a\libveldrid-spirv.so" Condition="Exists('$(NativeAssetsPath)android-arm64-v8a\libveldrid-spirv.so')">
            <PackagePath>runtimes/android-arm64/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)android-x86_64\libveldrid-spirv.so" Condition="Exists('$(NativeAssetsPath)android-x86_64\libveldrid-spirv.so')">
            <PackagePath>runtimes/android-x64/native</PackagePath>
            <Pack>true</Pack>
        </None>
        <None Include="$(NativeAssetsPath)android-x86\libveldrid-spirv.so" Condition="Exists('$(NativeAssetsPath)android-x86\libveldrid-spirv.so')">
            <PackagePath>runtimes/android-x86/native</PackagePath>
            <Pack>true</Pack>
        </None>
    </ItemGroup>

    <PropertyGroup>
        <Description>Veldrid integration for the SPIRV-Cross native library. Contains functionality to cross-compile SPIR-V bytecode into HLSL, GLSL, ESSL, and MSL shaders for use with Veldrid.</Description>
        <PackageTags>3D Graphics Direct3D DirectX Vulkan OpenGL Metal Core Standard Game</PackageTags>
    </PropertyGroup>

</Project>
